rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tenant-isolated business records adhering to Rexon PRD §9
    match /businesses/{businessId} {
      allow read, write: if true;
      
      // All subcollections: products, sales, customers, payments, stock_movements
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }
  }
}
